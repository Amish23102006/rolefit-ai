# Copy to .env (never commit .env). scripts/setup.sh does this for you and generates the secret.
# Use a secret manager in any real deployment.
ROLEFIT_JWT_SECRET=change-me-run-scripts-setup-sh-to-generate
ROLEFIT_DB_PATH=rolefit.db
# Trusted official career domains, plus * = also allow any other public https site (labelled "unverified site").
# Remove the * to allow only the named domains.
ROLEFIT_ALLOWED_JOB_DOMAINS=boards.greenhouse.io,job-boards.greenhouse.io,jobs.lever.co,jobs.ashbyhq.com,jobs.smartrecruiters.com,*

# ---- Optional LLM (free tier). Leave provider as "none" to run fully deterministic.
# Recommended: groq  (free key, no card: https://console.groq.com/keys). Local alternative: ollama.
ROLEFIT_LLM_PROVIDER=none
ROLEFIT_LLM_API_KEY=
# llama-3.3-70b-versatile was retired by Groq; check the Groq console for current model names.
ROLEFIT_LLM_MODEL=openai/gpt-oss-120b

# ---- Streamlit UI -> API address
API_URL=http://127.0.0.1:8000

# ---- Automatic job alerts (official Greenhouse / Lever / Ashby job-board APIs). 0 turns the scheduler off.
ROLEFIT_DISCOVERY_INTERVAL_HOURS=6

# ---- Email for new job alerts (optional). Gmail: use an App Password, never your normal password.
ROLEFIT_SMTP_HOST=
ROLEFIT_SMTP_PORT=587
ROLEFIT_SMTP_USER=
ROLEFIT_SMTP_PASSWORD=
